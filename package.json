{
  "name": "diepen-demos",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:inbox": "pnpm --filter @diepen/inbox dev",
    "dev:documents": "pnpm --filter @diepen/documents dev",
    "dev:meetings": "pnpm --filter @diepen/meetings dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e --concurrency 1",
    "verify": "node scripts/verify/cli.ts",
    "verify:map": "node scripts/verify/map-all.ts",
    "suppressions": "bash scripts/check-suppressions.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:map && pnpm suppressions && pnpm e2e"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.4.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
