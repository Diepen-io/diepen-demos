# The only secret. Without it every AI call uses the mock provider and the demos say so.
ANTHROPIC_API_KEY=

# "mock" forces the mock provider even when a key is set. Tests always set it.
AI_PROVIDER=

# Cost guards. Defaults in packages/ai/src/guards.ts apply when these are empty.
AI_DAILY_REQUEST_CAP=300
AI_RATE_LIMIT_PER_MINUTE=12
AI_MAX_OUTPUT_TOKENS=1200
